# Copy to .env for local development: cp .env.example .env
# On Render, set these under the service's Environment tab instead —
# see render.yaml for the full list Render expects.

# --- Database (required) ---
# Postgres connection string. Use Neon's "pooled connection" string for
# serverless-friendly behavior. SQLAlchemy also accepts postgres:// (it's
# rewritten to postgresql:// automatically in app/db.py).
DATABASE_URL="postgresql://user:password@localhost:5432/socioburp?schema=public"

# --- WhatsApp Cloud API (required) ---
# WA_VERIFY_TOKEN: invent any random string; reuse it in Meta's webhook config.
# WA_ACCESS_TOKEN: permanent System User token from Meta.
# WA_PHONE_NUMBER_ID: from Meta App Dashboard -> WhatsApp -> API Setup.
WA_VERIFY_TOKEN=""
WA_ACCESS_TOKEN=""
WA_PHONE_NUMBER_ID=""
WA_API_VERSION="v21.0"

# --- Claude (required) ---
ANTHROPIC_API_KEY=""
CLAUDE_INTENT_MODEL="claude-haiku-4-5-20251001"
CLAUDE_PROMPT_MODEL="claude-sonnet-4-6"

# --- Image generation (optional — set once a provider is chosen) ---
IMAGE_API_KEY=""
IMAGE_PROVIDER="openai"  # "openai" | "ideogram" | "flux"

# --- Storage: Cloudflare R2, S3-compatible (optional) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY=""
R2_SECRET_KEY=""
R2_BUCKET="socioburp-creatives"
R2_PUBLIC_BASE_URL=""  # e.g. https://cdn.socioburp.net

# --- Razorpay (optional, Week 3) ---
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# --- Alerts (optional but recommended) ---
ALERT_TELEGRAM_TOKEN=""
ALERT_TELEGRAM_CHAT_ID=""

# --- Instagram: Facebook Login for Business OAuth (optional) ---
# META_APP_ID / META_APP_SECRET: from your Meta App Dashboard.
# META_OAUTH_REDIRECT_URI: must exactly match a URI registered in Meta App
# Dashboard -> Facebook Login for Business -> Valid OAuth Redirect URIs,
# e.g. https://<your-render-service>.onrender.com/instagram/oauth/callback
META_APP_ID=""
META_APP_SECRET=""
META_OAUTH_REDIRECT_URI=""
META_GRAPH_API_VERSION="v21.0"
# Leave "false" outside of an active Meta App Review submission — enables
# the reviewer-only "app_review_demo" callback state (see app/instagram_oauth.py).
META_APP_REVIEW_DEMO_ENABLED="false"
# Inner gate alongside the flag above: knowing the demo state string isn't
# enough on its own, the reviewer link must also carry this exact secret.
# Generate with: python3 -c "import uuid; print(uuid.uuid4())"
APP_REVIEW_DEMO_TOKEN=""

# --- Business rules (optional, have defaults) ---
SIGNUP_BONUS_CREDITS="20"
LOW_BALANCE_THRESHOLD="3"
MAX_GENERATIONS_PER_HOUR="10"
